{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Help page front matter (Wiki 1.1)",
  "type": "object",
  "required": ["title", "description", "category", "order", "appliesTo", "personas", "featureSlug", "lastReviewed", "type"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 0 },
    "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "personas": { "type": "array", "items": { "enum": ["New Arrival", "Switcher", "Power User", "Collaborator"] } },
    "featureSlug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "type": { "enum": ["howto", "concept", "reference", "journey"] }
  }
}
