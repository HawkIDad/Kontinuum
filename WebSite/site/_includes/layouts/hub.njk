---
layout: base.njk
---
<article class="article">
  <header class="article-header">
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
  </header>
  <ul class="hub-list">
    {% for item in collections.helpPages | pagesIn(hub.slug) %}
    <li><a href="{{ item.url }}">{{ item.data.title }}</a><br><small>{{ item.data.description }}</small></li>
    {% endfor %}
  </ul>
</article>
