{
  "name": "notebytez-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NoteBytez public website (Eleventy + Pagefind)",
  "scripts": {
    "build": "rm -rf _site && eleventy && pagefind --site _site",
    "start": "eleventy --serve",
    "lint": "node scripts/checkIA.js",
    "audit": "node scripts/audit.js",
    "check:pages": "node scripts/checkPages.js",
    "test": "node --test test/",
    "check:links": "node scripts/checkLinks.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.5.0",
    "markdown-it": "^15.0.2",
    "pagefind": "^1.5.2",
    "puppeteer-core": "^25.11.0"
  }
}
