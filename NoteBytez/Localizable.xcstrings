    "Narrow the filter — reduce the depth or node types — to render this many notes as a force graph." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsnævr filteret — reducér dybden eller nodetyperne — for at gengive så mange noter som en kraftgraf."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter eingrenzen — Tiefe oder Knotentypen reduzieren —, um so viele Notizen als Force-Graph darzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίστε το φίλτρο — μειώστε το βάθος ή τους τύπους κόμβων — για να αποδοθούν τόσες σημειώσεις ως γράφος δυνάμεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el filtro (baja la profundidad o los tipos de nodo) para representar esta cantidad de notas como un grafo de fuerzas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kavenna suodatinta — vähennä syvyyttä tai solmutyyppejä — jotta näin monta muistiinpanoa voidaan näyttää voimapohjaisena graafina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restreignez le filtre (réduisez la profondeur ou les types de nœuds) pour représenter autant de notes sous forme de graphe à forces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringi il filtro (riduci la profondità o i tipi di nodo) per rappresentare così tante note come grafo a forze."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens filteret — reduser dybden eller nodetypene — for å vise så mange notater som en kraftbasert graf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verklein het filter — verminder de diepte of het aantal knooptypen — om dit aantal notities als krachtgrafiek weer te geven."
