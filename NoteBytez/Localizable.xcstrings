    "Add a field below — every new note from this template starts with it pre-filled." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj et felt nedenfor — hver ny note fra denne skabelon starter med det udfyldt på forhånd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie unten ein Feld hinzu — jede neue Notiz aus dieser Vorlage startet damit bereits ausgefüllt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ένα πεδίο παρακάτω — κάθε νέα σημείωση από αυτό το πρότυπο θα ξεκινά με αυτό προσυμπληρωμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un campo abajo: cada nota nueva de esta plantilla empezará con él ya completado."
          }
        },
        "fi" : {
          "stringUnit" : {
