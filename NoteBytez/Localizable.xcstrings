    "Pick the kinds of work you do and NoteBytez will add matching note templates. You can change these any time in Settings → Template Gallery." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de typer arbejde, du udfører, og NoteBytez tilføjer matchende note-skabeloner. Du kan altid ændre dette senere i Indstillinger → Skabelongalleri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Art Ihrer Arbeit, und NoteBytez fügt passende Notizvorlagen hinzu. Sie können dies jederzeit unter Einstellungen → Vorlagengalerie ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τα είδη εργασίας που κάνετε και το NoteBytez θα προσθέσει αντίστοιχα πρότυπα σημειώσεων. Μπορείτε να το αλλάξετε οποτεδήποτε από τις Ρυθμίσεις → Συλλογή προτύπων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los tipos de trabajo que haces y NoteBytez añadirá plantillas de notas correspondientes. Puedes cambiarlas en cualquier momento en Ajustes → Galería de plantillas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, millaista työtä teet, niin NoteBytez lisää vastaavia muistiinpanomalleja. Voit muuttaa tätä milloin tahansa kohdasta Asetukset → Mallikirjasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les types de travail que vous faites et NoteBytez ajoutera les modèles de notes correspondants. Vous pouvez les modifier à tout moment dans Réglages → Galerie de modèles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli i tipi di lavoro che svolgi e NoteBytez aggiungerà i modelli di nota corrispondenti. Puoi modificarli in qualsiasi momento in Impostazioni → Galleria modelli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvilke typer arbeid du gjør, så legger NoteBytez til matchende notatmaler. Du kan alltid endre dette senere i Innstillinger → Malgalleri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de soorten werk die u doet en NoteBytez voegt bijpassende notitiesjablonen toe. U kunt dit later altijd wijzigen in Instellingen → Sjabloongalerij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os tipos de trabalho que você faz e o NoteBytez adicionará modelos de nota correspondentes. Você pode alterá-los a qualquer momento em Ajustes → Galeria de Modelos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilka typer av arbete du gör så lägger NoteBytez till matchande anteckningsmallar. Du kan alltid ändra detta senare i Inställningar → Mallgalleri."
          }
        }
      }
    },
