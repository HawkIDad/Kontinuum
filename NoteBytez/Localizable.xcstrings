    "Add a field below — every new note from this template starts with it pre-filled." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte pole níže — každá nová poznámka z této šablony s ním začne předvyplněná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj et felt nedenfor — hver ny note fra denne skabelon starter med det udfyldt på forhånd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie unten ein Feld hinzu — jede neue Notiz aus dieser Vorlage startet damit bereits ausgefüllt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ένα πεδίο παρακάτω — κάθε νέα σημείωση από αυτό το πρότυπο θα ξεκινά με αυτό προσυμπληρωμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un campo abajo: cada nota nueva de esta plantilla empezará con él ya completado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kenttä alle — jokainen tästä mallista luotu uusi muistiinpano alkaa sen kanssa valmiiksi täytettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un champ ci-dessous : chaque nouvelle note issue de ce modèle en héritera pré-rempli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá egy mezőt alább — az ebből a sablonból készülő minden új jegyzet ezzel előre kitöltve indul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un campo qui sotto: ogni nuova nota da questo modello partirà già precompilata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にフィールドを追加してください。このテンプレートから作成する新しいメモには、あらかじめ入力された状態で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 필드를 추가하세요. 이 템플릿으로 만든 새 메모마다 미리 입력된 상태로 시작됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėkite lauką žemiau — kiekvienas naujas užrašas iš šio šablono prasidės su iš anksto užpildytu lauku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til et felt nedenfor — hvert nytt notat fra denne malen starter med det forhåndsutfylt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hieronder een veld toe — elke nieuwe notitie van dit sjabloon begint ermee vooraf ingevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
