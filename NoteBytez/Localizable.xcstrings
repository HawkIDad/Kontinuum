    "Narrow the filter — reduce the depth or node types — to render this many notes as a force graph." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zúžte filtr — snižte hloubku nebo typy uzlů — aby bylo možné vykreslit tolik poznámek jako silový graf."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsnævr filteret — reducér dybden eller nodetyperne — for at gengive så mange noter som en kraftgraf."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter eingrenzen — Tiefe oder Knotentypen reduzieren —, um so viele Notizen als Force-Graph darzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίστε το φίλτρο — μειώστε το βάθος ή τους τύπους κόμβων — για να αποδοθούν τόσες σημειώσεις ως γράφος δυνάμεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el filtro (baja la profundidad o los tipos de nodo) para representar esta cantidad de notas como un grafo de fuerzas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kavenna suodatinta — vähennä syvyyttä tai solmutyyppejä — jotta näin monta muistiinpanoa voidaan näyttää voimapohjaisena graafina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restreignez le filtre (réduisez la profondeur ou les types de nœuds) pour représenter autant de notes sous forme de graphe à forces."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szűkítse a szűrőt — csökkentse a mélységet vagy a csomóponttípusokat — hogy ennyi jegyzetet erőalapú gráfként lehessen megjeleníteni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringi il filtro (riduci la profondità o i tipi di nodo) per rappresentare così tante note come grafo a forze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィルターを絞り込んでください（深さやノードの種類を減らす）。この件数のメモをフォースレイアウトのグラフとして表示するために必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터 범위를 좁히세요(깊이나 노드 유형을 줄이세요). 이렇게 많은 메모를 포스 그래프로 표시하려면 필요합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susiaurinkite filtrą — sumažinkite gylį arba mazgų tipus — kad tiek daug užrašų būtų galima pavaizduoti kaip jėgų grafą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens filteret — reduser dybden eller nodetypene — for å vise så mange notater som en kraftbasert graf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verklein het filter — verminder de diepte of het aantal knooptypen — om dit aantal notities als krachtgrafiek weer te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęź filtr — zmniejsz głębokość lub liczbę typów węzłów — aby wyrenderować tyle notatek jako graf siłowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrinja o filtro — reduza a profundidade ou os tipos de nó — para renderizar essa quantidade de notas como um grafo de forças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restrânge filtrul — redu adâncimea sau tipurile de noduri — pentru a reda atâtea notițe ca grafic bazat pe forțe."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сузите филтер — смањите дубину или типове чворова — да бисте приказали толико белешки као граф сила."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsa filtret — minska djupet eller nodtyperna — för att rendera så här många anteckningar som en kraftgraf."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadar notu kuvvet grafiği olarak oluşturmak için filtreyi daraltın — derinliği veya düğüm türlerini azaltın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缩小筛选范围——减少深度或节点类型——以便将这么多笔记渲染为力导向图。"
          }
        }
      }
    },
