    "If you bought NoteBytez on the App Store, delete this copy and reinstall it from the App Store." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jste NoteBytez zakoupili v App Store, smažte tuto kopii a přeinstalujte ji z App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har købt NoteBytez i App Store, skal du slette denne kopi og geninstallere den fra App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie NoteBytez im App Store gekauft haben, löschen Sie diese Kopie und installieren Sie sie erneut aus dem App Store."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αγοράσατε το NoteBytez από το App Store, διαγράψτε αυτό το αντίγραφο και επανεγκαταστήστε το από το App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si compraste NoteBytez en el App Store, elimina esta copia y reinstálala desde el App Store."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos ostit NoteBytezin App Storesta, poista tämä kopio ja asenna se uudelleen App Storesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez acheté NoteBytez sur l'App Store, supprimez cette copie et réinstallez-la depuis l'App Store."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a NoteBytez alkalmazást az App Store-ból vásárolta, törölje ezt a példányt, és telepítse újra az App Store-ból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai acquistato NoteBytez sull'App Store, elimina questa copia e reinstallala dall'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store で NoteBytez を購入した場合は、このコピーを削除し、App Store から再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 NoteBytez를 구매했다면 이 복사본을 삭제하고 App Store에서 다시 설치하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei įsigijote „NoteBytez“ per App Store, ištrinkite šią kopiją ir iš naujo įdiekite ją iš App Store."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du kjøpte NoteBytez i App Store, slett denne kopien og installer den på nytt fra App Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u NoteBytez in de App Store hebt gekocht, verwijdert u deze kopie en installeert u deze opnieuw vanuit de App Store."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
