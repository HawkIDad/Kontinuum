    "Start with a free trial. Your subscription unlocks every device signed into your Apple Account, and your family through Family Sharing." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en gratis prøveperiode. Dit abonnement låser op for alle enheder, der er logget ind på din Apple Account, og din familie via Familiedeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie mit einer kostenlosen Testphase. Ihr Abonnement schaltet alle mit Ihrem Apple Account angemeldeten Geräte frei sowie Ihre Familie über die Familienfreigabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε με δωρεάν δοκιμή. Η συνδρομή σας ξεκλειδώνει κάθε συσκευή συνδεδεμένη στον λογαριασμό σας Apple, καθώς και την οικογένειά σας μέσω Κοινής Οικογενειακής Χρήσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una prueba gratuita. Tu suscripción desbloquea todos los dispositivos con sesión iniciada en tu cuenta de Apple, y tu familia mediante Compartir en familia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ilmaisella kokeilulla. Tilauksesi avaa käyttöoikeuden kaikille Apple-tilillesi kirjautuneille laitteille sekä perheellesi Perheen jakamisen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez avec un essai gratuit. Votre abonnement déverrouille tous les appareils connectés à votre compte Apple, ainsi que votre famille via le Partage familial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con una prova gratuita. Il tuo abbonamento sblocca tutti i dispositivi collegati al tuo account Apple e la tua famiglia tramite Famiglia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en gratis prøveperiode. Abonnementet ditt låser opp alle enheter som er logget inn på Apple-kontoen din, og familien din via Familiedeling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met een gratis proefperiode. Uw abonnement ontgrendelt elk apparaat dat is aangemeld bij uw Apple Account, en uw gezin via Gezinsdeling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com um teste gratuito. Sua assinatura libera todos os dispositivos conectados à sua Conta Apple, e sua família por meio do Compartilhamento Familiar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en kostnadsfri provperiod. Din prenumeration låser upp alla enheter som är inloggade på ditt Apple-konto, och din familj via Familjedelning."
          }
        }
      }
    },
