    "Snapshots are created automatically before risky operations, or manually below." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky se vytvářejí automaticky před rizikovými operacemi nebo ručně níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshots oprettes automatisk før risikable handlinger, eller manuelt nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnappschüsse werden automatisch vor riskanten Vorgängen erstellt oder unten manuell."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα snapshot δημιουργούνται αυτόματα πριν από επικίνδυνες ενέργειες, ή χειροκίνητα παρακάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instantáneas se crean automáticamente antes de operaciones riesgosas, o manualmente abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilannevedokset luodaan automaattisesti ennen riskialttiita toimintoja, tai manuaalisesti alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des instantanés sont créés automatiquement avant les opérations à risque, ou manuellement ci-dessous."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az pillanatképek automatikusan készülnek kockázatos műveletek előtt, vagy manuálisan lent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli snapshot vengono creati automaticamente prima di operazioni rischiose, oppure manualmente qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リスクのある操作の前にスナップショットが自動的に作成されます。以下から手動で作成することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위험한 작업 전에 스냅샷이 자동으로 생성됩니다. 아래에서 수동으로 만들 수도 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentinės kopijos kuriamos automatiškai prieš rizikingas operacijas arba rankiniu būdu žemiau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øyeblikksbilder opprettes automatisk før risikable handlinger, eller manuelt nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshots worden automatisch gemaakt vóór riskante bewerkingen, of handmatig hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migawki są tworzone automatycznie przed ryzykownymi operacjami lub ręcznie poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshots são criados automaticamente antes de operações arriscadas, ou manualmente abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantaneele sunt create automat înainte de operațiuni riscante sau manual mai jos."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимци стања се праве аутоматски пре ризичних операција, или ручно испод."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögonblicksbilder skapas automatiskt före riskfyllda åtgärder, eller manuellt nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlık görüntüler riskli işlemlerden önce otomatik olarak veya aşağıdan manuel olarak oluşturulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会在高风险操作前自动创建快照，你也可以在下方手动创建。"
          }
        }
      }
