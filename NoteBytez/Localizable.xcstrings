    "Snapshots are created automatically before risky operations, or manually below." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshots oprettes automatisk før risikable handlinger, eller manuelt nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnappschüsse werden automatisch vor riskanten Vorgängen erstellt oder unten manuell."
