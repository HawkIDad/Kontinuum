    "Start with a free trial. Your subscription unlocks every device signed into your Apple Account, and your family through Family Sharing." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte s bezplatnou zkušební verzí. Vaše předplatné odemkne každé zařízení přihlášené k vašemu Apple Account a vaši rodinu prostřednictvím Rodinného sdílení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en gratis prøveperiode. Dit abonnement låser op for alle enheder, der er logget ind på din Apple Account, og din familie via Familiedeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie mit einer kostenlosen Testphase. Ihr Abonnement schaltet alle mit Ihrem Apple Account angemeldeten Geräte frei sowie Ihre Familie über die Familienfreigabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε με δωρεάν δοκιμή. Η συνδρομή σας ξεκλειδώνει κάθε συσκευή συνδεδεμένη στον λογαριασμό σας Apple, καθώς και την οικογένειά σας μέσω Κοινής Οικογενειακής Χρήσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una prueba gratuita. Tu suscripción desbloquea todos los dispositivos con sesión iniciada en tu cuenta de Apple, y tu familia mediante Compartir en familia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ilmaisella kokeilulla. Tilauksesi avaa käyttöoikeuden kaikille Apple-tilillesi kirjautuneille laitteille sekä perheellesi Perheen jakamisen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez avec un essai gratuit. Votre abonnement déverrouille tous les appareils connectés à votre compte Apple, ainsi que votre famille via le Partage familial."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdje ingyenes próbaidőszakkal. Az előfizetése feloldja az Apple Accountjába bejelentkezett minden eszközt, valamint a családját a Családmegosztáson keresztül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con una prova gratuita. Il tuo abbonamento sblocca tutti i dispositivi collegati al tuo account Apple e la tua famiglia tramite Famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料トライアルから始めましょう。サブスクリプションは、同じ Apple Account でサインインしたすべてのデバイス、およびファミリー共有を通じてご家族にも適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 체험으로 시작하세요. 구독은 동일한 Apple 계정으로 로그인한 모든 기기에서, 그리고 패밀리 공유를 통해 가족과 함께 사용할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pradėkite nemokamu bandomuoju laikotarpiu. Jūsų prenumerata atrakina kiekvieną įrenginį, prijungtą prie jūsų „Apple Account“, ir jūsų šeimą per „Family Sharing“."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en gratis prøveperiode. Abonnementet ditt låser opp alle enheter som er logget inn på Apple-kontoen din, og familien din via Familiedeling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met een gratis proefperiode. Uw abonnement ontgrendelt elk apparaat dat is aangemeld bij uw Apple Account, en uw gezin via Gezinsdeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od bezpłatnego okresu próbnego. Twoja subskrypcja odblokowuje wszystkie urządzenia zalogowane na twoje konto Apple oraz twoją rodzinę dzięki funkcji Rodzina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com um teste gratuito. Sua assinatura libera todos os dispositivos conectados à sua Conta Apple, e sua família por meio do Compartilhamento Familiar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începe cu o perioadă de încercare gratuită. Abonamentul tău deblochează fiecare dispozitiv conectat la Apple Account, și familia ta prin Family Sharing."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почните са бесплатним пробним периодом. Ваша претплата откључава сваки уређај пријављен на ваш Apple налог, као и вашу породицу путем Породичног дељења."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en kostnadsfri provperiod. Din prenumeration låser upp alla enheter som är inloggade på ditt Apple-konto, och din familj via Familjedelning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz denemeyle başlayın. Aboneliğiniz, Apple Hesabınızda oturum açmış her cihazın ve Aile Paylaşımı aracılığıyla ailenizin kilidini açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从免费试用开始。你的订阅可解锁登录同一 Apple 账户的所有设备，并可通过家人共享让家人一同使用。"
          }
        }
      }
    },
