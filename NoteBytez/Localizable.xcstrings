    "Only grant what this plugin actually needs. The sandbox enforces each permission individually — a permission left off here can never be reached by the script, no matter what it asks for." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv kun det, som dette plugin faktisk har brug for. Sandboxen håndhæver hver tilladelse individuelt — en tilladelse, der ikke gives her, kan aldrig nås af scriptet, uanset hvad det beder om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähren Sie nur, was dieses Plugin tatsächlich benötigt. Die Sandbox setzt jede Berechtigung einzeln durch — eine hier nicht erteilte Berechtigung ist für das Skript unerreichbar, egal was es anfordert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραχωρήστε μόνο ό,τι χρειάζεται πραγματικά αυτό το πρόσθετο. Το sandbox επιβάλλει κάθε δικαίωμα ξεχωριστά — ένα δικαίωμα που δεν παραχωρείται εδώ δεν μπορεί ποτέ να προσπελαστεί από το script, ανεξάρτητα από το τι ζητά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede solo lo que este plugin realmente necesita. El sandbox aplica cada permiso individualmente: un permiso no concedido aquí nunca podrá ser alcanzado por el script, sin importar lo que pida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myönnä vain se, mitä tämä laajennus todella tarvitsee. Hiekkalaatikko valvoo jokaista käyttöoikeutta erikseen — täältä pois jätettyyn käyttöoikeuteen skripti ei koskaan pääse käsiksi, riippumatta siitä, mitä se pyytää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'accordez que ce dont ce plugin a réellement besoin. Le bac à sable applique chaque autorisation individuellement — une autorisation non cochée ici ne pourra jamais être atteinte par le script, quoi qu'il demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi solo ciò di cui questo plugin ha davvero bisogno. La sandbox applica ogni permesso singolarmente: un permesso non concesso qui non potrà mai essere raggiunto dallo script, qualunque cosa richieda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi bare det denne utvidelsen faktisk trenger. Sandkassen håndhever hver tillatelse individuelt — en tillatelse som ikke gis her, kan aldri nås av skriptet, uansett hva det ber om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen alleen wat deze plug-in daadwerkelijk nodig heeft. De sandbox handhaaft elke machtiging afzonderlijk — een machtiging die hier niet is verleend, kan nooit door het script worden bereikt, ongeacht wat het vraagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda apenas o que este plugin realmente precisa. O sandbox aplica cada permissão individualmente — uma permissão não concedida aqui nunca poderá ser alcançada pelo script, não importa o que ele solicite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevilja bara det som det här tillägget faktiskt behöver. Sandlådan upprätthåller varje behörighet individuellt — en behörighet som inte beviljas här kan aldrig nås av skriptet, oavsett vad det begär."
          }
        }
      }
    },
