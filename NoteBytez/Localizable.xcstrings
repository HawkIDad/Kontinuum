    "Payment is charged to your Apple Account. Subscriptions renew automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen opkræves på din Apple Account. Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før periodens udløb. Administrer eller annuller i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung wird Ihrem Apple Account belastet. Abonnements verlängern sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird. Verwalten oder kündigen Sie in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πληρωμή χρεώνεται στον λογαριασμό σας Apple. Οι συνδρομές ανανεώνονται αυτόματα, εκτός εάν ακυρωθούν τουλάχιστον 24 ώρες πριν από το τέλος της περιόδου. Διαχειριστείτε ή ακυρώστε στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se carga a tu cuenta de Apple. Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes del final del período. Gestiona o cancela en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksu veloitetaan Apple-tililtäsi. Tilaukset uusiutuvat automaattisesti, ellei niitä peruuteta vähintään 24 tuntia ennen jakson päättymistä. Hallinnoi tai peruuta Asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement est débité de votre compte Apple. Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gérez ou annulez dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento viene addebitato sul tuo account Apple. Gli abbonamenti si rinnovano automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestisci o annulla in Impostazioni."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen belastes din Apple-konto. Abonnementer fornyes automatisk med mindre de kanselleres minst 24 timer før periodens slutt. Administrer eller kanseller i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De betaling wordt in rekening gebracht op uw Apple Account. Abonnementen worden automatisch verlengd, tenzij ten minste 24 uur voor het einde van de periode wordt opgezegd. Beheer of annuleer in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento é cobrado na sua Conta Apple. As assinaturas são renovadas automaticamente, a menos que canceladas com pelo menos 24 horas de antecedência do fim do período. Gerencie ou cancele em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalningen debiteras ditt Apple-konto. Prenumerationer förnyas automatiskt om de inte avbryts minst 24 timmar före periodens slut. Hantera eller avbryt i Inställningar."
          }
        }
      }
    },
