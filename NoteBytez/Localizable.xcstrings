    "Pick the kinds of work you do and NoteBytez will add matching note templates. You can change these any time in Settings → Template Gallery." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte druhy práce, kterou děláte, a NoteBytez přidá odpovídající šablony poznámek. Kdykoli je můžete změnit v Nastavení → Galerie šablon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de typer arbejde, du udfører, og NoteBytez tilføjer matchende note-skabeloner. Du kan altid ændre dette senere i Indstillinger → Skabelongalleri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Art Ihrer Arbeit, und NoteBytez fügt passende Notizvorlagen hinzu. Sie können dies jederzeit unter Einstellungen → Vorlagengalerie ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τα είδη εργασίας που κάνετε και το NoteBytez θα προσθέσει αντίστοιχα πρότυπα σημειώσεων. Μπορείτε να το αλλάξετε οποτεδήποτε από τις Ρυθμίσεις → Συλλογή προτύπων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los tipos de trabajo que haces y NoteBytez añadirá plantillas de notas correspondientes. Puedes cambiarlas en cualquier momento en Ajustes → Galería de plantillas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, millaista työtä teet, niin NoteBytez lisää vastaavia muistiinpanomalleja. Voit muuttaa tätä milloin tahansa kohdasta Asetukset → Mallikirjasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les types de travail que vous faites et NoteBytez ajoutera les modèles de notes correspondants. Vous pouvez les modifier à tout moment dans Réglages → Galerie de modèles."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, milyen jellegű munkát végez, és a NoteBytez hozzáadja a megfelelő jegyzetsablonokat. Ezeket bármikor módosíthatja a Beállítások → Sablon-galéria menüben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli i tipi di lavoro che svolgi e NoteBytez aggiungerà i modelli di nota corrispondenti. Puoi modificarli in qualsiasi momento in Impostazioni → Galleria modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行っている仕事の種類を選んでください。NoteBytez がそれに合ったメモテンプレートを追加します。この設定は、いつでも「設定 → テンプレートギャラリー」から変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하는 일의 종류를 선택하면 NoteBytez가 그에 맞는 메모 템플릿을 추가합니다. 설정 → 템플릿 갤러리에서 언제든지 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite, kokį darbą dirbate, ir „NoteBytez“ pridės atitinkamus užrašų šablonus. Bet kada galite tai pakeisti skiltyje Nustatymai → Šablonų galerija."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvilke typer arbeid du gjør, så legger NoteBytez til matchende notatmaler. Du kan alltid endre dette senere i Innstillinger → Malgalleri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de soorten werk die u doet en NoteBytez voegt bijpassende notitiesjablonen toe. U kunt dit later altijd wijzigen in Instellingen → Sjabloongalerij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz rodzaje pracy, którą wykonujesz, a NoteBytez doda pasujące szablony notatek. Możesz to zmienić w dowolnym momencie w Ustawienia → Galeria szablonów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os tipos de trabalho que você faz e o NoteBytez adicionará modelos de nota correspondentes. Você pode alterá-los a qualquer momento em Ajustes → Galeria de Modelos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege tipurile de muncă pe care le faci, iar NoteBytez va adăuga șabloane de notițe potrivite. Le poți schimba oricând din Setări → Galerie de șabloane."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите врсте посла којим се бавите и NoteBytez ће додати одговарајуће шаблоне белешки. Ово можете променити у сваком тренутку у Подешавања → Галерија шаблона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilka typer av arbete du gör så lägger NoteBytez till matchande anteckningsmallar. Du kan alltid ändra detta senare i Inställningar → Mallgalleri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaptığınız iş türlerini seçin, NoteBytez size uygun not şablonları ekleyecektir. Bunları istediğiniz zaman Ayarlar → Şablon Galerisi'nden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你从事的工作类型，NoteBytez 会添加相应的笔记模板。你可以随时在设置 → 模板库 中更改。"
          }
        }
      }
    },
